# ==================== TRINETRA — Environment Variables ====================
# Copy this file to .env:
#   cp .env.example .env
#
# Docker Compose auto-loads .env from project root.
# Required: POSTGRES_PASSWORD (Docker won't start without it)
# Optional: API_KEY, HIBP_API_KEY (leave empty for dev mode)

# ==================== Database (PostgreSQL - Docker) ====================
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=trinetra

# For local SQLite dev (no Docker), uncomment:
# DATABASE_URL=sqlite+aiosqlite:///./trinetra.db

# ==================== Redis (optional) ====================
# Leave empty = tasks run inline (dev mode)
# For production: redis://redis:6379/0
REDIS_URL=

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ==================== API Authentication ====================
# Leave empty = open access (dev mode).
# Set a strong key to enable auth for production.
# Accepted formats: Authorization: Bearer <key> or X-API-Key: <key>
API_KEY=

# ==================== External API Keys ====================
# Have I Been Pwned v3 API key (optional, for enhanced data leak checks)
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ==================== Telegram OSINT Bot (optional) ====================
# Leave empty to disable the Telegram bot integration
# Bot token from @BotFather: https://core.telegram.org/bots#botfather
TELEGRAM_BOT_TOKEN=
# Base URL of the OSINT leak-search API the bot queries
TELEGRAM_OSINT_API_URL=
# API key sent as X-API-Key header to the OSINT leak-search API
TELEGRAM_OSINT_API_KEY=

# ==================== AI Chatbot (Google Gemini) ====================
# Leave empty to disable the in-app AI chatbot / report generation feature
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini model used for chatbot replies (default shown below is usually fine)
GEMINI_MODEL=gemini-flash-latest

# ==================== Email Verification (SMTP) ====================
# Generic SMTP settings — works with Gmail, SendGrid, Mailgun, Amazon SES,
# Zoho Mail, Outlook/Office365, or any standard SMTP provider.
#
# Leave SMTP_HOST empty to run in "dev mode": OTP codes are printed to the
# backend console log instead of being emailed, so local dev keeps working
# without real credentials. Fill these in for production so OTPs are
# actually delivered by email.
#
# ---- Gmail example ----
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USERNAME=youraddress@gmail.com
#   SMTP_PASSWORD=<16-character Gmail "App Password", not your login password>
#   SMTP_FROM_EMAIL=youraddress@gmail.com
#
# Gmail App Passwords require 2-Step Verification enabled on the Google
# account, then create one at: https://myaccount.google.com/apppasswords
#
# ---- Any other SMTP provider (SendGrid, Mailgun, SES, Zoho, etc.) ----
# Just use the SMTP host/port/username/password they give you — the same
# four settings below work the same way for all of them.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS (port 587, recommended) vs implicit SSL (port 465) — set only one to true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# "From" address shown to recipients (defaults to SMTP_USERNAME if left empty)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TRINETRA

# ==================== OTP / Signup Verification Behavior ====================
# Leave defaults as-is unless you have a specific reason to change them.
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
# Reject known disposable/throwaway email domains (mailinator, guerrillamail, etc.)
BLOCK_DISPOSABLE_EMAILS=true
# Reject email domains with no valid mail server (MX record lookup via DNS)
VERIFY_EMAIL_MX=true

# ==================== Cashfree Payment Gateway ====================
# Leave empty to disable payment features (free access mode)
# Get credentials: https://cashfree.com/developers
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" for testing, "production" for live payments
CASHFREE_ENV=sandbox
# Webhook URL for Cashfree to POST payment events (set to your backend URL)
CASHFREE_WEBHOOK_URL=http://localhost:8000/api/payment/webhook